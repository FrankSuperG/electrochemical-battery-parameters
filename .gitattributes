* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
# Preserve experimental files byte-for-byte, including source line endings.
*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
src/ebp/data/evidence/*.txt -text -whitespace
src/ebp/data/evidence/*.m -text -whitespace
# Keep the publisher's license text as obtained.
src/ebp/licenses/* -text -whitespace
