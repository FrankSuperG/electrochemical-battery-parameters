{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External full-cell dataset links",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "material_families",
          "cell_identity",
          "test_types",
          "profiles",
          "rate_summary",
          "temperatures_C",
          "channels",
          "storage",
          "source",
          "license",
          "review",
          "parameter_link",
          "evidence_urls",
          "file_links",
          "missing_items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "material_families": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "LFP",
                "NMC",
                "NCA",
                "LCO",
                "NCO",
                "Other",
                "Unknown"
              ]
            }
          },
          "cell_identity": {
            "type": "string",
            "minLength": 1
          },
          "test_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "constant_current",
                "cccv",
                "pulse",
                "dynamic",
                "eis",
                "ocv"
              ]
            }
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rate_summary": {
            "type": "string",
            "minLength": 1
          },
          "temperatures_C": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "number"
            }
          },
          "channels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_series",
              "frequency_domain",
              "note"
            ],
            "properties": {
              "time_series": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "frequency_domain": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "storage": {
            "const": "external_link"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "doi",
              "version"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^10\\."
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "evidence_url",
              "note"
            ],
            "properties": {
              "identifier": {
                "enum": [
                  "CC-BY-4.0",
                  "BSD-3-Clause",
                  "not-stated"
                ]
              },
              "evidence_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checked_on",
              "level",
              "note"
            ],
            "properties": {
              "checked_on": {
                "type": "string",
                "format": "date"
              },
              "level": {
                "enum": [
                  "source_metadata_only",
                  "existing_source_audit"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "parameter_link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cell_ids",
              "match_level",
              "evidence",
              "missing_components"
            ],
            "properties": {
              "cell_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "match_level": {
                "enum": [
                  "unmatched",
                  "same_model_different_study",
                  "same_model_same_study",
                  "same_specimen"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "missing_components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "file_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "md5": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "missing_items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "catalog_evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
